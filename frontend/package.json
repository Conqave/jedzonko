{
  "name": "jedzonko-frontend",
  "version": "0.0.1",
  "description": "jedzonko frontend",
  "productName": "jedzonko",
  "author": "jedzonko",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "quasar prepare --silent",
    "dev": "quasar dev",
    "build": "quasar build",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\" \"*.{js,ts,json}\"",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.20.0",
    "pinia": "^4.0.2",
    "quasar": "^2.33.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.9.0",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
