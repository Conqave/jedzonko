DJANGO_SECRET_KEY=change-me-in-a-real-deployment
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9000

MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=jedzonko
MARIADB_USER=jedzonko
MARIADB_PASSWORD=change-me-app
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306

# Number of matched Blix leaflets fetched per search; each leaflet response is around 1 MB.
PROMOTIONS_SEARCH_LEAFLET_LIMIT=5
# Maximum number of promotion offers returned by one search, applied after de-duplication and ordering.
PROMOTIONS_SEARCH_RESULT_LIMIT=200

# External recipe source (Ania Gotuje), read live on every request; nothing is stored.
RECIPE_SOURCE_HTTP_TIMEOUT_SECONDS=10
RECIPE_SOURCE_HTTP_USER_AGENT=jedzonko/0.1 (+https://github.com/Conqave/jedzonko)
# Maximum recipes returned by one external search page.
RECIPE_SOURCE_PAGE_SIZE_LIMIT=24
# The provider filters ingredients with AND, so a whole pantry would match nothing;
# this bounds how many pantry products a suggestion query may ask about.
RECIPE_SOURCE_SUGGESTION_INGREDIENT_LIMIT=5
